    <script>
        let isDeviceLive = false;
        let scoreCounter = 0;
        let selectedRingtone = 'ring_1';
        let systemVolume = 0.7;

        let audioCtx = null;
        let activeOscillators = [];
        let ringtoneInterval = null;

        const bootScreen = document.getElementById('bootScreen');
        const bootPopcorn = document.getElementById('bootPopcorn');
        const bootTitle = document.getElementById('bootTitle');
        const bootVersion = document.getElementById('bootVersion');
        const bootStatus = document.getElementById('bootStatus');
        const powerOffScreen = document.getElementById('powerOffScreen');
        const osInterface = document.getElementById('osInterface');
        const systemActionMenu = document.getElementById('systemActionMenu');
        const menuHardwareKey = document.getElementById('menuHardwareKey');
        const desktopNotice = document.getElementById('desktopNotice');
        const chatHistory = document.getElementById('chatHistory');
        const typingIndicator = document.getElementById('typingIndicator');

        // --- Wallpapers Database ---
        const wallpapersCollection = {
            1: { name: "Neon Dusk", css: "linear-gradient(135deg, #f02fc2 0%, #6094ea 100%)", cat: "abstract" },
            2: { name: "Solar Flare", css: "radial-gradient(circle at center, #f12711, #f5af19)", cat: "abstract" },
