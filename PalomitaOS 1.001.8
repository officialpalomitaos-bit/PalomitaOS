<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PalomitaOS v1.001.8 - Update</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* --- Reset & Base Styles --- */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: #111;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            color: #ffffff;
            overflow: hidden;
        }

        /* --- Hardware Chassis --- */
        .phone-container {
            width: 380px;
            height: 760px;
            background: #222;
            border-radius: 42px;
            padding: 14px;
            box-shadow: 0 25px 60px rgba(0,0,0,0.85), inset 0 2px 3px rgba(255,255,255,0.1);
            border: 3px solid #333;
            display: flex;
            flex-direction: column;
            position: relative;
        }

        .speaker {
            width: 90px;
            height: 5px;
            background: #111;
            border-radius: 3px;
            margin: 8px auto 14px auto;
            box-shadow: inset 0 1px 2px rgba(0,0,0,0.8);
        }

        .screen {
            flex: 1;
            background: #000;
            border-radius: 4px;
            overflow: hidden;
            position: relative;
            border: 2px solid #151515;
        }

        /* Physical Bottom Keys */
        .hardware-buttons {
            height: 52px;
            display: flex;
            justify-content: space-around;
            align-items: center;
            padding: 0 5px;
            margin-top: 12px;
            background: linear-gradient(to bottom, #333, #1a1a1a);
            border-radius: 8px;
            border-bottom: 2px solid #0a0a0a;
        }

        .hw-btn {
            color: #aaa;
            font-size: 15px;
            cursor: pointer;
            padding: 12px;
            transition: color 0.1s;
        }

        .hw-btn:active, .hw-btn.active {
            color: #ffb300;
            text-shadow: 0 0 8px #ffb300;
        }

        /* --- OS Screen Overlays --- */
        .boot-screen {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: #000;
            z-index: 100;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            opacity: 1;
        }

        /* Pure Hard Shutdown Dead State Overlay */
        .power-off-screen {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: #000;
            z-index: 110;
            display: none;
            justify-content: center;
            align-items: center;
            color: #444;
            font-size: 12px;
            font-family: monospace;
        }

        .popcorn-animation {
            font-size: 75px;
            position: relative;
            transition: transform 0.2s;
        }

        .popcorn-animation::after {
            content: '💥';
            position: absolute;
            font-size: 40px;
            top: -10px; right: -25px;
            opacity: 0;
        }

        .popcorn-animation.crunch::after {
            animation: crunchAnim 0.3s ease-out forwards;
        }

        .os-title {
            margin-top: 25px;
            font-family: monospace;
            font-weight: bold;
            font-size: 26px;
            letter-spacing: 3px;
            color: #fff;
            opacity: 0;
            text-align: center;
        }

        .os-version-tag {
            font-size: 12px;
            color: #ffb300;
            font-family: monospace;
            margin-top: 5px;
            letter-spacing: 1px;
            opacity: 0;
        }

        .os-title.visible, .os-version-tag.visible { opacity: 1; transition: opacity 0.4s; }

        .boot-status {
            position: absolute;
            bottom: 40px;
            font-family: monospace;
            font-size: 11px;
            color: #666;
            width: 100%;
            text-align: center;
            padding: 0 20px;
        }

        /* --- Main OS Desktop Engine --- */
        .os-interface {
            width: 100%; height: 100%;
            display: flex;
            flex-direction: column;
            background-size: cover;
            background-position: center;
            transition: background 0.5s ease;
        }

        .os-interface.light-theme { color: #222; }
        .os-interface.light-theme .status-bar { background: rgba(255,255,255,0.6); color: #000; }
        .os-interface.light-theme .clock-card { background: linear-gradient(to bottom, #fff 50%, #eee 51%); color: #111; border-color: #ccc; }
        .os-interface.light-theme .app-label { color: #111; text-shadow: 0 1px 1px rgba(255,255,255,0.8); }

        .status-bar {
            height: 24px;
            padding: 0 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 11px;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(4px);
            z-index: 10;
        }

        .status-right i { margin-left: 5px; }

        .htc-widget { padding: 25px 20px 5px 20px; text-align: center; }
        .flip-clock { display: flex; justify-content: center; gap: 6px; }

        .clock-card {
            background: linear-gradient(to bottom, #252525 50%, #151515 51%);
            border-radius: 6px;
            padding: 8px 12px;
            font-size: 52px;
            font-weight: bold;
            font-family: monospace;
            border: 1px solid #3a3a3a;
            box-shadow: 0 6px 12px rgba(0,0,0,0.6);
            min-width: 80px;
            color: #fff;
        }

        .clock-location {
            margin-top: 8px;
            font-size: 13px;
            color: #ffb300;
            text-transform: uppercase;
            letter-spacing: 2px;
            text-shadow: 0 1px 3px rgba(0,0,0,0.8);
        }

        .app-grid { flex: 1; display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; padding: 25px 20px; align-content: start; }
        .app-icon { display: flex; flex-direction: column; align-items: center; cursor: pointer; }

        .icon-wrapper {
            width: 56px; height: 56px;
            border-radius: 14px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 24px;
            margin-bottom: 6px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.4);
            border: 1px solid rgba(255,255,255,0.1);
            transition: transform 0.1s;
        }

        .app-icon:active .icon-wrapper { transform: scale(0.9); }
        .app-label { font-size: 11px; text-align: center; color: #eaeaea; text-shadow: 0 1px 2px rgba(0,0,0,0.8); }

        .icon-phone { background: linear-gradient(135deg, #2ecc71, #27ae60); }
        .icon-messages { background: linear-gradient(135deg, #29b6f6, #0288d1); }
        .icon-browser { background: linear-gradient(135deg, #e67e22, #d35400); }
        .icon-popcorn { background: linear-gradient(135deg, #f1c40f, #f39c12); }
        .icon-settings { background: linear-gradient(135deg, #7f8c8d, #95a5a6); }

        .desktop-notice {
            margin: 0 20px 15px 20px; padding: 10px; background: rgba(0,0,0,0.6);
            border-left: 3px solid #ffb300; border-radius: 4px; font-size: 12px;
            display: none; color: #fff !important;
        }

        /* --- System Context Menu Overlay --- */
        .system-menu-overlay {
            position: absolute; bottom: -100%; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.75); backdrop-filter: blur(8px); z-index: 90;
            transition: bottom 0.3s cubic-bezier(0.1, 0.8, 0.3, 1);
            display: flex; flex-direction: column; justify-content: flex-end;
        }

        .system-menu-overlay.open { bottom: 0; }
        .menu-container { background: #1c1c1e; border-radius: 20px 20px 0 0; padding: 15px 10px 25px 10px; box-shadow: 0 -10px 30px rgba(0,0,0,0.5); border-top: 1px solid #333; }
        .menu-title { text-align: center; font-size: 13px; color: #888; margin-bottom: 15px; text-transform: uppercase; letter-spacing: 1px; }
        .menu-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }

        .menu-btn {
            background: #2c2c2e; border: 1px solid #3a3a3c; border-radius: 12px; color: #fff;
            padding: 16px 10px; font-size: 14px; font-weight: 600; text-align: center;
            cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 8px;
            transition: background 0.15s, transform 0.1s;
        }

        .menu-btn:active { background: #3a3a3c; transform: scale(0.97); }
        .menu-btn i { font-size: 18px; }

        .btn-reboot { color: #5ac8fa; }
        .btn-cancel { color: #ff3b30; grid-column: span 2; background: #3a3a3c; }
        .btn-sos { color: #ff9500; }
        .btn-wallpaper { color: #34c759; }
        .btn-virus { color: #af52de; }
        .btn-reset { color: #ff3b30; }

        /* --- App Windows / Tool Modals --- */
        .app-modal {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: #121212; z-index: 80; display: none; flex-direction: column; color: #fff;
        }

        .modal-header {
            height: 48px; background: #1a1a1c; display: flex; align-items: center; justify-content: space-between;
            padding: 0 15px; border-bottom: 1px solid #2b2b2d; font-weight: bold; font-size: 15px;
        }

        .modal-header i { cursor: pointer; padding: 5px; }
        .modal-body { flex: 1; padding: 15px; overflow-y: auto; display: flex; flex-direction: column; }

        /* Phone App Features */
        .dialer-container { display: flex; flex-direction: column; height: 100%; width: 100%; }
        .dialer-screen {
            background: #000; height: 50px; border-radius: 6px; margin-bottom: 15px;
            font-size: 28px; display: flex; align-items: center; justify-content: space-between;
            padding: 0 15px; color: #2ecc71; font-family: monospace; overflow: hidden; border: 1px solid #222;
        }
        .dialer-screen i { font-size: 20px; color: #ff9500; cursor: pointer; }
        .dialer-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; flex: 1; }
        .dial-btn {
            background: #1c1c1e; border-radius: 10px; display: flex; flex-direction: column;
            justify-content: center; align-items: center; border: 1px solid #2c2c2e; cursor: pointer;
        }
        .dial-btn:active { background: #2c2c2e; }
        .dial-btn span { font-size: 22px; font-weight: bold; }

        /* Messages Layout Framework */
        .chat-container { display: flex; flex-direction: column; height: 100%; width: 100%; margin: -15px; background: #151518; }
        .chat-header { background: #1f1f23; padding: 10px 15px; display: flex; align-items: center; gap: 10px; border-bottom: 1px solid #2a2a30; }
        .chat-avatar { width: 34px; height: 34px; background: #ffb300; border-radius: 50%; display: flex; justify-content: center; align-items: center; color: #000; font-weight: bold; font-size: 14px; }
        .chat-user-info { display: flex; flex-direction: column; }
        .chat-user-name { font-size: 13px; font-weight: bold; }
        .chat-status { font-size: 10px; color: #34c759; }
        .chat-history { flex: 1; padding: 15px; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; }
        .msg-bubble { max-width: 75%; padding: 10px 14px; border-radius: 16px; font-size: 13px; line-height: 1.4; word-wrap: break-word; }
        .msg-system { background: #2a2a30; color: #fff; align-self: flex-start; border-bottom-left-radius: 4px; }
        .msg-user { background: #0288d1; color: #fff; align-self: flex-end; border-bottom-right-radius: 4px; }
        .chat-input-bar { display: flex; padding: 10px; background: #1f1f23; border-top: 1px solid #2a2a30; gap: 8px; align-items: center; }
        .chat-input { flex: 1; background: #000; border: 1px solid #3a3a42; border-radius: 20px; color: #fff; padding: 8px 14px; font-size: 13px; outline: none; }
        .chat-send-btn { background: #0288d1; border: none; width: 34px; height: 34px; border-radius: 50%; color: #fff; display: flex; justify-content: center; align-items: center; cursor: pointer; transition: background 0.1s; }
        .chat-send-btn:active { background: #01579b; }
        .typing-indicator { font-style: italic; color: #777; font-size: 11px; align-self: flex-start; display: none; margin-left: 5px; }

        /* Settings App Layout Modifications */
        .settings-section { margin-bottom: 18px; background: #1c1c1e; border-radius: 10px; padding: 12px; border: 1px solid #2c2c2e; width: 100%; }
        .settings-section h4 { font-size: 12px; color: #ffb300; text-transform: uppercase; margin-bottom: 10px; letter-spacing: 0.5px; }
        .settings-row { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid #2c2c2e; }
        .settings-row:last-child { border-bottom: none; }
        
        .ringtone-select { background: #2c2c2e; color: #fff; border: 1px solid #444; padding: 6px; border-radius: 5px; font-size: 12px; outline: none; width: 150px; }
        .btn-preview { background: #ffb300; color: #000; border: none; padding: 6px 12px; border-radius: 4px; font-size: 11px; font-weight: bold; cursor: pointer; }
        .settings-slider { width: 120px; accent-color: #ffb300; }
        
        /* Wallpapers Section Expanded Grid System */
        .wallpaper-category-title { font-size: 11px; color: #888; text-transform: uppercase; margin: 12px 0 6px 0; font-weight: bold; }
        .wallpaper-large-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
        .wp-thumbnail-card { height: 95px; border-radius: 6px; border: 2px solid #2c2c2e; cursor: pointer; position: relative; overflow: hidden; display: flex; align-items: flex-end; padding: 4px; }
        .wp-thumbnail-card:hover { border-color: #ffb300; }
        .wp-label-tag { font-size: 9px; background: rgba(0,0,0,0.7); color: #fff; padding: 2px 4px; border-radius: 3px; width: 100%; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

        /* iOS Toggle Switch Layout */
        .switch { position: relative; display: inline-block; width: 44px; height: 24px; }
        .switch input { opacity: 0; width: 0; height: 0; }
        .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #444; transition: .3s; border-radius: 24px; }
        .slider:before { position: absolute; content: ""; height: 18px; width: 18px; left: 3px; bottom: 3px; background-color: white; transition: .3s; border-radius: 50%; }
        input:checked + .slider { background-color: #34c759; }
        input:checked + .slider:before { transform: translateX(20px); }

        /* Browser Content Simulation */
        .browser-container { display: flex; flex-direction: column; height: 100%; margin: -15px; width: calc(100% + 30px); }
        .browser-bar { display: flex; padding: 8px; background: #1f1f1f; gap: 5px; border-bottom: 1px solid #333; }
        .browser-input { flex: 1; background: #000; border: 1px solid #444; border-radius: 4px; color: #fff; padding: 5px 10px; font-size: 12px; }
        .browser-btn { background: #e67e22; color: #fff; border: none; padding: 5px 12px; border-radius: 4px; font-weight: bold; cursor: pointer; }
        .browser-view { flex: 1; background: #fff; color: #000; padding: 15px; font-size: 14px; }

        /* Kernel Game */
        .popper-container { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; text-align: center; width: 100%; }
        .pot { width: 120px; height: 120px; background: #444; border-radius: 0 0 40px 40px; position: relative; margin-bottom: 20px; border: 4px solid #222; cursor: pointer; }
        .popcorn-spawn-area { position: absolute; width: 100px; height: 100px; top: -50px; left: 10px; pointer-events: none; }
        .popped-kernel { position: absolute; font-size: 24px; animation: popExplode 0.5s ease-out forwards; }

        /* SOS App */
        .sos-alert-box { background: #2c1616; border: 1px solid #ff3b30; padding: 15px; border-radius: 8px; text-align: center; margin-bottom: 20px; width: 100%; }
        .beacon-btn { width: 120px; height: 120px; background: #ff3b30; border-radius: 50%; margin: 30px auto; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: bold; cursor: pointer; animation: pulse 1.5s infinite; }

        /* Virus Scanner Engine App */
        .scanner-container { text-align: center; padding-top: 20px; width: 100%; }
        .radar-disc { width: 130px; height: 130px; border: 3px solid #af52de; border-radius: 50%; margin: 0 auto 25px auto; position: relative; display: flex; align-items: center; justify-content: center; }
        .radar-line { position: absolute; width: 50%; height: 2px; background: #af52de; top: 50%; left: 50%; transform-origin: left center; display: none; }
        .radar-line.scanning { display: block; animation: radarRotate 1s linear infinite; }
        .scan-log { background: #000; border: 1px solid #333; font-family: monospace; padding: 10px; height: 140px; border-radius: 6px; text-align: left; font-size: 11px; overflow-y: auto; color: #34c759; margin-top: 20px; }

        /* Factory Wipe elements */
        .reset-warn { text-align: center; color: #ff3b30; margin-bottom: 20px; width: 100%; }
        .reset-warn i { font-size: 48px; margin-bottom: 10px; }
        .confirm-reset-btn { background: #ff3b30; color: white; border: none; width: 100%; padding: 14px; border-radius: 8px; font-weight: bold; cursor: pointer; margin-top: 30px; }

        /* --- Keyframe Animations --- */
        @keyframes crunchAnim { 0% { opacity: 0; transform: scale(0.6); } 50% { opacity: 1; } 100% { opacity: 0; transform: scale(1.3); } }
        @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(255, 59, 48, 0.7); } 70% { box-shadow: 0 0 0 20px rgba(255, 59, 48, 0); } 100% { box-shadow: 0 0 0 0 rgba(255, 59, 48, 0); } }
        @keyframes radarRotate { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
        @keyframes popExplode {
            0% { transform: translateY(40px) scale(0.5); opacity: 1; }
            50% { transform: translateY(-40px) translateX(var(--x)) scale(1.3); }
            100% { transform: translateY(10px) translateX(var(--x)) scale(1); opacity: 0; }
        }
    </style>
</head>
<body onmousedown="unmuteBrowserContext()">

    <div class="phone-container">
        <div class="speaker"></div>
        
        <div class="screen" id="phoneScreen">
            
            <div class="power-off-screen" id="powerOffScreen" onclick="triggerPalomitaColdBoot()">
                <div style="text-align:center;"><i class="fas fa-power-off" style="font-size:32px; margin-bottom:10px; color:#333;"></i><br><span style="color:#555;">Device Off. Tap screen to Power On.</span></div>
            </div>

            <div class="boot-screen" id="bootScreen">
                <div class="popcorn-animation" id="bootPopcorn">🍿</div>
                <div class="os-title" id="bootTitle">PalomitaOS</div>
                <div class="os-version-tag" id="bootVersion">Build 1.001.8</div>
                <div class="boot-status" id="bootStatus">Accessing hardware...</div>
            </div>

            <div class="os-interface" id="osInterface" style="display: none;">
                <div class="status-bar">
                    <span id="liveTime">12:00</span>
                    <div class="status-right">
                        <i class="fas fa-wifi"></i>
                        <i class="fas fa-signal"></i>
                        <i class="fas fa-battery-full"></i>
                    </div>
                </div>

                <div class="htc-widget">
                    <div class="flip-clock">
                        <div class="clock-card" id="wHour">12</div>
                        <div class="clock-card" id="wMin">00</div>
                    </div>
                    <div class="clock-location">Palomita Core</div>
                </div>

                <div class="app-grid">
                    <div class="app-icon" onclick="launchModal('modalPhone')">
                        <div class="icon-wrapper icon-phone"><i class="fas fa-phone"></i></div>
                        <div class="app-label">Phone</div>
                    </div>
                    <div class="app-icon" onclick="launchModal('modalMessages')">
                        <div class="icon-wrapper icon-messages"><i class="fas fa-comment-alt"></i></div>
                        <div class="app-label">Messages</div>
                    </div>
                    <div class="app-icon" onclick="launchModal('modalBrowser')">
                        <div class="icon-wrapper icon-browser"><i class="fas fa-globe"></i></div>
                        <div class="app-label">Browser</div>
                    </div>
                    <div class="app-icon" onclick="launchModal('modalKernel')">
                        <div class="icon-wrapper icon-popcorn"><i class="fas fa-fire"></i></div>
                        <div class="app-label">Kernel Lab</div>
                    </div>
                    <div class="app-icon" onclick="launchModal('modalSettings')" style="grid-column: span 4; margin: 5px auto 0 auto;">
                        <div class="icon-wrapper icon-settings"><i class="fas fa-cog"></i></div>
                        <div class="app-label">Settings</div>
                    </div>
                </div>

                <div class="desktop-notice" id="desktopNotice"></div>
            </div>

            <div class="app-modal" id="modalPhone">
                <div class="modal-header"><span>Phone Dialer</span><i class="fas fa-times" onclick="closeModal('modalPhone')"></i></div>
                <div class="modal-body">
                    <div class="dialer-container">
                        <div class="dialer-screen">
                            <span id="dialerDisplay"></span>
                            <i class="fas fa-bell" onclick="simulateIncomingCall()" title="Trigger Incoming Test Ring"></i>
                        </div>
                        <div class="dialer-grid">
                            <div class="dial-btn" onmousedown="startTone('1')" onmouseup="stopTone()" onmouseleave="stopTone()"><span>1</span></div>
                            <div class="dial-btn" onmousedown="startTone('2')" onmouseup="stopTone()" onmouseleave="stopTone()"><span>2</span></div>
                            <div class="dial-btn" onmousedown="startTone('3')" onmouseup="stopTone()" onmouseleave="stopTone()"><span>3</span></div>
                            <div class="dial-btn" onmousedown="startTone('4')" onmouseup="stopTone()" onmouseleave="stopTone()"><span>4</span></div>
                            <div class="dial-btn" onmousedown="startTone('5')" onmouseup="stopTone()" onmouseleave="stopTone()"><span>5</span></div>
                            <div class="dial-btn" onmousedown="startTone('6')" onmouseup="stopTone()" onmouseleave="stopTone()"><span>6</span></div>
                            <div class="dial-btn" onmousedown="startTone('7')" onmouseup="stopTone()" onmouseleave="stopTone()"><span>7</span></div>
                            <div class="dial-btn" onmousedown="startTone('8')" onmouseup="stopTone()" onmouseleave="stopTone()"><span>8</span></div>
                            <div class="dial-btn" onmousedown="startTone('9')" onmouseup="stopTone()" onmouseleave="stopTone()"><span>9</span></div>
                            <div class="dial-btn" onmousedown="startTone('*')" onmouseup="stopTone()" onmouseleave="stopTone()"><span>*</span></div>
                            <div class="dial-btn" onmousedown="startTone('0')" onmouseup="stopTone()" onmouseleave="stopTone()"><span>0</span></div>
                            <div class="dial-btn" style="background:#802222;" onclick="pressDialClear()"><span style="color:#fff;"><i class="fas fa-backspace"></i></span></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="app-modal" id="modalMessages">
                <div class="modal-header"><span>Messages</span><i class="fas fa-times" onclick="closeModal('modalMessages')"></i></div>
                <div class="modal-body">
                    <div class="chat-container">
                        <div class="chat-header">
                            <div class="chat-avatar">AI</div>
