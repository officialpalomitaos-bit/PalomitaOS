            5: { name: "Orchid Velvet", css: "radial-gradient(circle, #654ea3, #eaafc8)", cat: "abstract" },
            6: { name: "Candy Crush", css: "linear-gradient(45deg, #ff9a9e 0%, #fecfef 99%, #fecfef 100%)", cat: "abstract" },
            7: { name: "Sense Classic", css: "radial-gradient(circle at center, #2c3e50, #0f171e)", cat: "retro" },
            8: { name: "Monochrome Grid", css: "linear-gradient(rgba(18,18,18,0.95), rgba(18,18,18,0.95)), repeating-linear-gradient(0deg, #333 0px, #333 1px, transparent 1px, transparent 20px), repeating-linear-gradient(90deg, #333 0px, #333 1px, transparent 1px, transparent 20px)", cat: "retro" },
            9: { name: "Cyberpunk CRT", css: "linear-gradient(to bottom, #111 50%, #221a22 51%)", cat: "retro" },
            10: { name: "Amiga Copper", css: "linear-gradient(180deg, #b827fc 0%, #2c9cdb 25%, #bfae1a 50%, #5f961e 75%, #a21a1a 100%)", cat: "retro" },
            11: { name: "Matrix Code", css: "radial-gradient(circle, #051e05, #000000)", cat: "retro" },
            12: { name: "GameBoy Olive", css: "linear-gradient(to bottom, #9bbc0f, #8bac0f)", cat: "retro" },
            13: { name: "Dark Void", css: "linear-gradient(135deg, #111 25%, #223 100%)", cat: "cyber" },
            14: { name: "Carbon Fiber", css: "radial-gradient(#333 15%, transparent 16%), repeating-linear-gradient(45deg, rgba(0,0,0,0.1) 0px, rgba(0,0,0,0.1) 2px, transparent 2px, transparent 10px), #151515", cat: "cyber" },
            15: { name: "Chroma Shift", css: "linear-gradient(to right, #00223e, #1d976c)", cat: "cyber" },
            16: { name: "Crimson Eclipse", css: "radial-gradient(circle at 80% 20%, #ff0055 0%, #000000 70%)", cat: "cyber" },
            17: { name: "Polar Ice", css: "linear-gradient(to top, #e6e9f0 0%, #eef1f5 100%)", cat: "cyber" },
            18: { name: "Steel Hull", css: "linear-gradient(135deg, #232526 0%, #414345 100%)", cat: "cyber" }
        };

        // --- Ringtones Collection ---
        const ringtonesCollection = {
            'ring_1': { name: "Palomita Classic Tone", notes: [440, 440, 0, 480, 480, 0, 520, 520], type: "sine", speed: 150 },
            'ring_2': { name: "Marimba Pop Remix", notes: [880, 987, 1046, 1318, 0, 1318, 0, 1046], type: "triangle", speed: 180 },
            'ring_3': { name: "Kernel Burst Synth", notes: [600, 900, 400, 1200, 300, 1500, 0, 800], type: "sawtooth", speed: 120 },
            'ring_4': { name: "Digital Arpeggiator", notes: [300, 400, 500, 600, 700, 800, 900, 1000], type: "sine", speed: 100 },
            'ring_5': { name: "Retro Chiptune Run", notes: [523, 587, 659, 698, 784, 880, 987, 1047], type: "square", speed: 130 },
            'ring_6': { name: "Cyber Warning Siren", notes: [900, 600, 900, 600, 900, 600, 900, 600], type: "sawtooth", speed: 250 },
            'ring_7': { name: "Minimalist Beep Code", notes: [2000, 0, 2000, 0, 2000, 0, 2000, 0], type: "sine", speed: 200 },
            'ring_8': { name: "Echoing Horizon", notes: [440, 0, 554, 0, 659, 0, 880, 0], type: "triangle", speed: 300 },
            'ring_9': { name: "8-Bit Arcade Boss", notes: [150, 300, 150, 450, 150, 600, 800, 100], type: "square", speed: 140 },
            'ring_10': { name: "Cosmic Radar Pulse", notes: [1200, 0, 0, 1200, 0, 0, 1200, 0], type: "sine", speed: 400 },
            'ring_11': { name: "Hyper Drive Alert", notes: [800, 850, 900, 950, 1000, 1050, 1100, 1150], type: "sawtooth", speed: 80 },
            'ring_12': { name: "Sub-Bass Drone Loop", notes: [100, 110, 100, 90, 100, 120, 100, 80], type: "sine", speed: 350 },
            'ring_13': { name: "Techno Step Chime", notes: [440, 660, 440, 880, 554, 659, 440, 0], type: "triangle", speed: 160 },
            'ring_14': { name: "Emergency Broadcast", notes: [440, 880, 440, 880, 440, 880, 0, 0], type: "sawtooth", speed: 220 },
            'ring_15': { name: "Dreamy Glass Harmonics", notes: [1046, 1175, 1319, 1568, 1319, 1175, 1046, 0], type: "sine", speed: 250 },
            'ring_16': { name: "Glitch Matrix Error", notes: [88, 800, 50, 900, 60, 1200, 40, 1500], type: "square", speed: 90 },
            'ring_17': { name: "Zen Morning Bell", notes: [329, 0, 0, 0, 392, 0, 0, 0], type: "sine", speed: 500 },
            'ring_18': { name: "Palomita Final Outro", notes: [261, 329, 392, 523, 659, 784, 1046, 1318], type: "triangle", speed: 110 }
        };

        const dtmfFrequencies = {
            '1': [697, 1209], '2': [697, 1336], '3': [697, 1477],
            '4': [770, 1209], '5': [770, 1336], '6': [770, 1477],
            '7': [852, 1209], '8': [852, 1336], '9': [852, 1477],
            '*': [941, 1209], '0': [941, 1336], '#': [941, 1477]
        };

        function unmuteBrowserContext() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
        }

        function buildSettingsInterface() {
            const chooser = document.getElementById('ringtoneChooser');
            chooser.innerHTML = "";
            for (let id in ringtonesCollection) {
                let opt = document.createElement('option');
                opt.value = id;
                opt.innerText = ringtonesCollection[id].name;
                chooser.appendChild(opt);
            }

            document.getElementById('wpGridAbstract').innerHTML = "";
            document.getElementById('wpGridRetro').innerHTML = "";
            document.getElementById('wpGridCyber').innerHTML = "";

            for (let id in wallpapersCollection) {
                let wp = wallpapersCollection[id];
                let thumb = document.createElement('div');
                thumb.className = 'wp-thumbnail-card';
                thumb.style.background = wp.css;
                thumb.style.backgroundSize = "cover";
                thumb.onclick = () => changeWallpaper(id);
                
                let label = document.createElement('span');
                label.className = 'wp-label-tag';
                label.innerText = wp.name;
                thumb.appendChild(label);

                if (wp.cat === 'abstract') document.getElementById('wpGridAbstract').appendChild(thumb);
                if (wp.cat === 'retro') document.getElementById('wpGridRetro').appendChild(thumb);
                if (wp.cat === 'cyber') document.getElementById('wpGridCyber').appendChild(thumb);
            }
        }

        // Clock Loop
        setInterval(() => {
            const time = new Date();
            let hr = time.getHours(); let mn = time.getMinutes();
            hr = hr < 10 ? '0' + hr : hr; mn = mn < 10 ? '0' + mn : mn;
            document.getElementById('liveTime').innerText = `${hr}:${mn}`;
            document.getElementById('wHour').innerText = hr; document.getElementById('wMin').innerText = mn;
        }, 1000);

        // Dialer Sound Synthesis Handler
        function startTone(digit) {
            if (!isDeviceLive) return;
            unmuteBrowserContext();
            stopTone();
            
            document.getElementById('dialerDisplay').innerText += digit;

            if (dtmfFrequencies[digit]) {
                const freqs = dtmfFrequencies[digit];
                const gainNode = audioCtx.createGain();
                gainNode.gain.setValueAtTime(systemVolume * 0.3, audioCtx.currentTime);
                gainNode.connect(audioCtx.destination);
                
                const osc1 = audioCtx.createOscillator(); 
                osc1.type = 'sine'; 
                osc1.frequency.setValueAtTime(freqs[0], audioCtx.currentTime); 
                osc1.connect(gainNode);
                
                const osc2 = audioCtx.createOscillator(); 
                osc2.type = 'sine'; 
                osc2.frequency.setValueAtTime(freqs[1], audioCtx.currentTime); 
                osc2.connect(gainNode);

                osc1.start(); 
                osc2.start(); 
                activeOscillators = [osc1, osc2, gainNode];
            }
        }

        function stopTone() { 
            if (activeOscillators.length > 0) { 
                activeOscillators[0].stop(); 
                activeOscillators[1].stop(); 
                activeOscillators = []; 
            } 
        }

        function pressDialClear() { document.getElementById('dialerDisplay').innerText = document.getElementById('dialerDisplay').innerText.slice(0, -1); playClickTone(); }

        function playClickTone() {
            unmuteBrowserContext(); 
            if(!audioCtx || systemVolume === 0) return;
            const osc = audioCtx.createOscillator(); const gain = audioCtx.createGain();
            osc.type = 'sine'; osc.frequency.setValueAtTime(1100, audioCtx.currentTime);
            gain.gain.setValueAtTime(systemVolume * 0.12, audioCtx.currentTime); gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.05);
            osc.connect(gain); gain.connect(audioCtx.destination); osc.start(); osc.stop(audioCtx.currentTime + 0.06);
        }

        function playMessageSound(isIncoming) {
            unmuteBrowserContext();
            if(!audioCtx || systemVolume === 0) return;
            const osc = audioCtx.createOscillator(); const gain = audioCtx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(isIncoming ? 660 : 880, audioCtx.currentTime);
            if (isIncoming) {
                osc.frequency.exponentialRampToValueAtTime(880, audioCtx.currentTime + 0.1);
            } else {
                osc.frequency.exponentialRampToValueAtTime(1200, audioCtx.currentTime + 0.08);
            }
            gain.gain.setValueAtTime(systemVolume * 0.2, audioCtx.currentTime); gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.15);
            osc.connect(gain); gain.connect(audioCtx.destination); osc.start(); osc.stop(audioCtx.currentTime + 0.16);
        }

        // --- Simulated AI Chat Logic Engine ---
        function sendChatMessage() {
            const input = document.getElementById('chatInputField');
            const text = input.value.trim();
            if(!text || !isDeviceLive) return;

            input.value = "";
            appendMessageBubble(text, 'user');
            playMessageSound(false);

            typingIndicator.style.display = "block";
            chatHistory.scrollTop = chatHistory.scrollHeight;

            setTimeout(() => {
                typingIndicator.style.display = "none";
                const aiReply = generateAISimulationResponse(text);
                appendMessageBubble(aiReply, 'system');
                playMessageSound(true);
            }, 1000 + Math.random() * 800);
        }

        function appendMessageBubble(text, sender) {
            const bubble = document.createElement('div');
            bubble.className = `msg-bubble msg-${sender}`;
            bubble.innerText = text;
            chatHistory.appendChild(bubble);
            chatHistory.scrollTop = chatHistory.scrollHeight;
        }

        function generateAISimulationResponse(input) {
            const query = input.toLowerCase();
            if (query.includes('hi') || query.includes('hello') || query.includes('hey')) {
                return "Greetings! How is your experience with the current PalomitaOS configuration framework running?";
            }
            if (query.includes('popcorn') || query.includes('kernel') || query.includes('pop')) {
                return "Kernel modules loaded! Have you checked out the Kernel Mini-Lab app? The popping physics engine is highly optimized.";
            }
            if (query.includes('sound') || query.includes('dialer') || query.includes('beep')) {
                return "The DTMF audio matrix has been fully synchronized with user mouse activation protocols to bypass sound blocks.";
            }
            if (query.includes('weather')) {
                return "The core atmosphere diagnostics indicate a perfectly stable 72°F inside this sandboxed layout framework.";
            }
            if (query.includes('version') || query.includes('os') || query.includes('build')) {
                return "This system is currently running PalomitaOS Build 1.001.8 with sandbox optimization features deployed.";
            }
            if (query.includes('clear')) {
                chatHistory.innerHTML = "";
                return "Chat buffer logs systematically recycled.";
            }
            return "Acknowledged. Processing command string inside PalomitaOS virtual loops. Anything else I can adjust for you?";
        }

        function previewRingtone() {
            unmuteBrowserContext(); 
            clearInterval(ringtoneInterval);
            if(systemVolume === 0) return;

            let data = ringtonesCollection[selectedRingtone];
            let index = 0;

            ringtoneInterval = setInterval(() => {
                if (index >= data.notes.length || !isDeviceLive) { clearInterval(ringtoneInterval); return; }
                let freq = data.notes[index];
                if (freq > 0) {
                    const osc = audioCtx.createOscillator(); const gain = audioCtx.createGain();
                    osc.type = data.type; osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
                    gain.gain.setValueAtTime(systemVolume * 0.25, audioCtx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + (data.speed / 1000) * 0.9);
                    osc.connect(gain); gain.connect(audioCtx.destination); osc.start(); osc.stop(audioCtx.currentTime + (data.speed / 1000));
                }
                index++;
            }, data.speed);
        }

        function simulateIncomingCall() { showDesktopNotice(`Incoming Call Ringing...`); previewRingtone(); }
        function updateSelectedRingtone() { selectedRingtone = document.getElementById('ringtoneChooser').value; }
        function updateVolumeSetting() { systemVolume = document.getElementById('volumeSlider').value / 100; playClickTone(); }
        function toggleDarkModeSetting() { if(!document.getElementById('darkModeToggle').checked) { osInterface.classList.add('light-theme'); } else { osInterface.classList.remove('light-theme'); } playClickTone(); }

        // Core Power Stack Controller Engine
        function executeHardShutdown() {
            isDeviceLive = false;
            clearInterval(ringtoneInterval);
            stopTone();
            closeCurrentUIFlow();
            osInterface.style.display = "none";
            bootScreen.style.display = "none";
            powerOffScreen.style.display = "flex";
        }

        function triggerPalomitaColdBoot() {
            isDeviceLive = false; 
            clearInterval(ringtoneInterval);
            powerOffScreen.style.display = "none";
            systemActionMenu.classList.remove('open'); 
            menuHardwareKey.classList.remove('active');
            osInterface.style.display = "none"; 
            
            bootScreen.style.opacity = "1"; 
            bootScreen.style.display = "flex";
            bootPopcorn.innerHTML = "🍿"; 
            bootPopcorn.classList.remove('crunch'); 
            bootTitle.classList.remove('visible');
            bootVersion.classList.remove('visible');
            bootStatus.innerText = "Loading system hardware partitions...";

            setTimeout(() => { bootStatus.innerText = "PalomitaOS decrypting system files kernels..."; bootPopcorn.classList.add('crunch'); }, 1100);
            setTimeout(() => { 
                bootPopcorn.innerHTML = "🌽"; 
                bootTitle.classList.add('visible'); 
                bootVersion.classList.add('visible');
                bootStatus.innerText = "System integrity checked. Initializing components."; 
            }, 1800);
            
            setTimeout(() => { 
                bootScreen.style.opacity = "0"; 
                osInterface.style.display = "flex"; 
                isDeviceLive = true; 
                setTimeout(() => bootScreen.style.display = "none", 400); 
            }, 3200);
        }

        function toggleSystemActionMenu() {
            if (!isDeviceLive) return;
            playClickTone();
            if (systemActionMenu.classList.contains('open')) { systemActionMenu.classList.remove('open'); menuHardwareKey.classList.remove('active'); } 
            else { systemActionMenu.classList.add('open'); menuHardwareKey.classList.add('active'); }
        }

        function menuAction(actionKey) {
            systemActionMenu.classList.remove('open'); menuHardwareKey.classList.remove('active');
            playClickTone();
            
            if (actionKey === 'shutdown') {
                executeHardShutdown();
                return;
            }

            if (!isDeviceLive) return;
            switch(actionKey) {
                case 'reboot': triggerPalomitaColdBoot(); break;
                case 'cancel': break;
                case 'sos': launchModal('modalSos'); break;
                case 'wallpaper': launchModal('modalSettings'); break;
                case 'virus': launchModal('modalVirus'); break;
                case 'reset': launchModal('modalReset'); break;
            }
        }

        function launchModal(modalId) { if (!isDeviceLive) return; closeCurrentUIFlow(); playClickTone(); document.getElementById(modalId).style.display = 'flex'; }
        function closeModal(modalId) { clearInterval(ringtoneInterval); document.getElementById(modalId).style.display = 'none'; playClickTone(); }
        function closeCurrentUIFlow() { clearInterval(ringtoneInterval); const openModals = document.querySelectorAll('.app-modal'); openModals.forEach(m => m.style.display = 'none'); systemActionMenu.classList.remove('open'); menuHardwareKey.classList.remove('active'); }

        function navigateBrowser() {
            playClickTone(); const url = document.getElementById('browserUrl').value.toLowerCase().trim(); const view = document.getElementById('browserContent');
            if(url.includes('popcorn')) { view.innerHTML = `<h4>Search Queries: "Popcorn"</h4><p style="margin-top:8px;">1. Fresh buttery code segments located in Palomita ecosystem assets.</p>`; } 
            else if(url.includes('kernels.com')) { view.innerHTML = `<h4>Internal System Status Logs</h4><p style="color:green; margin-top:8px;">● Main Processing Cluster Operational</p>`; } 
            else { view.innerHTML = `<h4>HTTP Simulated Error 404</h4><p style="margin-top:8px; color:red;">"${url}" does not have active paths.</p>`; }
        }

        function popCornItem() {
            scoreCounter++; document.getElementById('popScore').innerText = `Score: ${scoreCounter} Popped`;
            unmuteBrowserContext();
            if(audioCtx && systemVolume > 0) {
                const osc = audioCtx.createOscillator(); const gain = audioCtx.createGain(); osc.type = 'sine'; osc.frequency.setValueAtTime(150 + Math.random() * 600, audioCtx.currentTime);
                gain.gain.setValueAtTime(systemVolume * 0.2, audioCtx.currentTime); gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.04);
                osc.connect(gain); gain.connect(audioCtx.destination); osc.start(); osc.stop(audioCtx.currentTime + 0.05);
            }
            const area = document.getElementById('spawnArea'); const item = document.createElement('div'); item.className = 'popped-kernel'; item.innerText = '🍿';
            item.style.setProperty('--x', (Math.random() * 80 - 40) + 'px'); area.appendChild(item); setTimeout(() => item.remove(), 500);
        }

        function triggerSosPing() { alert("🚨 EMERGENCY SOS BROADCAST SENT"); showDesktopNotice("Emergency SOS activated."); closeModal('modalSos'); }
        
        function changeWallpaper(idx) {
            let selectedWp = wallpapersCollection[idx];
            osInterface.style.background = selectedWp.css;
            osInterface.style.backgroundSize = "cover";
            showDesktopNotice(`Wallpaper switched to: ${selectedWp.name}`);
        }

        function executeVirusScan() {
            const sweep = document.getElementById('radarSweep'); const log = document.getElementById('scanLogger'); sweep.classList.add('scanning'); log.innerHTML = "Initializing security heuristic scans...<br>";
            setTimeout(() => { log.innerHTML += "Reading directory blocks: /system/bin/...<br>"; }, 700);
            setTimeout(() => { log.innerHTML += "Verifying binary verification variables...<br>"; }, 1500);
            setTimeout(() => { sweep.classList.remove('scanning'); log.innerHTML += "<br><strong>SCAN EXECUTED: Secure.</strong>"; showDesktopNotice("Security routine completed."); }, 2600);
        }

        function executeHardFactoryWipe() {
            closeModal('modalReset'); osInterface.style.display = "none"; bootScreen.style.display = "flex"; bootScreen.style.opacity = "1";
            bootPopcorn.innerHTML = "💀"; bootTitle.classList.remove('visible'); bootVersion.classList.remove('visible'); bootStatus.innerHTML = "<span style='color:red;'>PURGING SYSTEM ARTIFACT REGISTERS...</span>";
            setTimeout(() => { bootStatus.innerText = "Rebuilding system image root folders..."; }, 1500);
            setTimeout(() => { 
                changeWallpaper(1); osInterface.classList.remove('light-theme'); document.getElementById('darkModeToggle').checked = true;
                document.getElementById('volumeSlider').value = 70; systemVolume = 0.7; selectedRingtone = 'ring_1';
                desktopNotice.style.display = "none"; scoreCounter = 0; document.getElementById('popScore').innerText = `Score: 0 Popped`; document.getElementById('dialerDisplay').innerText = '';
                chatHistory.innerHTML = '<div class="msg-bubble msg-system">Hello! I am the automated PalomitaOS Core AI. Type something to start testing our communication arrays!</div>';
                triggerPalomitaColdBoot(); 
            }, 3500);
        }

        function showDesktopNotice(txt) { desktopNotice.innerText = txt; desktopNotice.style.display = "block"; setTimeout(() => { desktopNotice.style.display = "none"; }, 5000); }

        menuHardwareKey.addEventListener('click', toggleSystemActionMenu);
        
        window.onload = function() {
            buildSettingsInterface();
            changeWallpaper(1);
            setTimeout(triggerPalomitaColdBoot, 300);
        };
    </script>
</body>
</html>
